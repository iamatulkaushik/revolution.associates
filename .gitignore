# ============================================================
#  Revolution Associates — .gitignore
# ============================================================

# Environment & secrets — NEVER commit these
.env
*.env
.env.*
!.env.example

raw_data.text
readme.md
whole_project.md

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Database — never commit live data (contains PII: Aadhaar, PAN, bank accounts)
db.sqlite3
*.sqlite3

# Dead / backup source files
*.py.old
*.py.bak

# Django collected static (generated by collectstatic)
static_collected/

# Media uploads (user-uploaded files — back up separately, not in git)
media/

# Logs (generated at runtime)
logs/
*.log

# Virtual environments
venv/
.venv/
env/
ENV/
.claude/
.amazonq/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Coverage / testing
.coverage
htmlcov/
.pytest_cache/

# Build artefacts
dist/
build/
*.egg-info/
.env
.gitignore
PRODUCTION_READINESS_REPORT.md
req.txt
requirements.txt
Aapp/migrations
Sapp/migrations
Capp/migrations
Cxapp/migrations
